{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Errors are RFC 7807 problem+json; clients branch on the `code` property.",
    "title" : "Stampede API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin as the frontend"
  } ],
  "paths" : {
    "/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Logged in; the refresh token is set as an httpOnly cookie"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INVALID_CREDENTIALS"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR"
          }
        },
        "tags" : [ "auth" ]
      }
    },
    "/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Requested-With",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "cookie",
          "name" : "stampede_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Logged out; the refresh cookie is cleared"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "FORBIDDEN"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR"
          }
        },
        "tags" : [ "auth" ]
      }
    },
    "/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Requested-With",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "cookie",
          "name" : "stampede_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Rotated; the new refresh token is set as an httpOnly cookie"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INVALID_REFRESH_TOKEN"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "FORBIDDEN"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR"
          }
        },
        "tags" : [ "auth" ]
      }
    },
    "/auth/register" : {
      "post" : {
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            },
            "description" : "Registered"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "EMAIL_TAKEN"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR"
          }
        },
        "tags" : [ "auth" ]
      }
    },
    "/events" : {
      "get" : {
        "operationId" : "listEvents",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventList"
                }
              }
            },
            "description" : "OK"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR"
          }
        },
        "tags" : [ "events" ]
      }
    },
    "/events/{id}" : {
      "get" : {
        "operationId" : "getEvent",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventDetail"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "EVENT_NOT_FOUND"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR"
          }
        },
        "tags" : [ "events" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "EventDetail" : {
        "type" : "object",
        "properties" : {
          "dropAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "perUserLimit" : {
            "type" : "integer",
            "format" : "int32"
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "SCHEDULED", "LIVE", "PAUSED", "SOLD_OUT", "ENDED" ]
          },
          "tiers" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PriceTier"
            }
          },
          "title" : {
            "type" : "string"
          },
          "venue" : {
            "$ref" : "#/components/schemas/VenueRef"
          }
        },
        "required" : [ "dropAt", "id", "perUserLimit", "serverTime", "startsAt", "status", "tiers", "title", "venue" ]
      },
      "EventList" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EventSummary"
            }
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "items", "serverTime" ]
      },
      "EventSummary" : {
        "type" : "object",
        "properties" : {
          "dropAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "perUserLimit" : {
            "type" : "integer",
            "format" : "int32"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "SCHEDULED", "LIVE", "PAUSED", "SOLD_OUT", "ENDED" ]
          },
          "title" : {
            "type" : "string"
          },
          "venue" : {
            "$ref" : "#/components/schemas/VenueRef"
          }
        },
        "required" : [ "dropAt", "id", "perUserLimit", "startsAt", "status", "title", "venue" ]
      },
      "FieldError" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "email", "password" ]
      },
      "PriceTier" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "pricePaise" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "id", "name", "pricePaise" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 7807 problem details, served as application/problem+json.",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Stable error code (PRD section 10). Branch on this, never on title or detail.",
            "enum" : [ "VALIDATION_FAILED", "UNAUTHENTICATED", "INVALID_CREDENTIALS", "INVALID_REFRESH_TOKEN", "FORBIDDEN", "EMAIL_TAKEN", "EVENT_NOT_FOUND", "NOT_FOUND", "METHOD_NOT_ALLOWED", "UNSUPPORTED_MEDIA_TYPE", "REQUEST_FAILED", "INTERNAL_ERROR" ]
          },
          "detail" : {
            "type" : "string",
            "description" : "Human-readable; may change."
          },
          "errorId" : {
            "type" : "string",
            "description" : "INTERNAL_ERROR only: the id the server logged the error under."
          },
          "errors" : {
            "type" : "array",
            "description" : "VALIDATION_FAILED on a request body: one entry per invalid field.",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "instance" : {
            "type" : "string",
            "description" : "The request path."
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "description" : "Always about:blank for now."
          }
        },
        "required" : [ "code", "status", "title" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string"
          }
        },
        "required" : [ "email" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          },
          "tokenType" : {
            "type" : "string"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "role" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "id", "role" ]
      },
      "VenueRef" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ]
      }
    }
  }
}
