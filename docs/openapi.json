          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "EVENT_NOT_FOUND"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR"
          }
        },
        "summary" : "Which seats are available now",
        "tags" : [ "events" ]
      }
    },
