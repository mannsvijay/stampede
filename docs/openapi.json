  "components" : {
    "schemas" : {
      "EventDetail" : {
        "type" : "object",
        "properties" : {
          "dropAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "perUserLimit" : {
            "type" : "integer",
            "format" : "int32"
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "SCHEDULED", "LIVE", "PAUSED", "SOLD_OUT", "ENDED" ]
          },
          "tiers" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PriceTier"
            }
          },
          "title" : {
            "type" : "string"
          },
          "venue" : {
            "$ref" : "#/components/schemas/VenueRef"
          }
        },
        "required" : [ "dropAt", "id", "perUserLimit", "serverTime", "startsAt", "status", "tiers", "title", "venue" ]
      },
      "EventLayout" : {
        "type" : "object",
        "properties" : {
          "eventId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "seats" : {
            "type" : "array",
            "description" : "Seats are sorted by seat id as PostgreSQL orders uuid values (byte by byte, the same as comparing the lowercase text form). A seat's position in this list is its bit index in GET /events/{id}/seatmap.",
            "items" : {
              "$ref" : "#/components/schemas/LayoutSeat"
            }
          },
          "venue" : {
            "$ref" : "#/components/schemas/VenueLayout"
          }
        },
        "required" : [ "eventId", "seats", "venue" ]
      },
      "EventList" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EventSummary"
            }
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "items", "serverTime" ]
      },
      "EventSummary" : {
        "type" : "object",
        "properties" : {
          "dropAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
