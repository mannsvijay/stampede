POSTGRES_DB=stampede
POSTGRES_USER=stampede
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Auth (M0.5). Signing key for access tokens: base64 of at least 32 random bytes.
# Generate with: openssl rand -base64 32
STAMPEDE_JWT_SECRET=change-me-run-openssl-rand-base64-32
# First ADMIN user, created only when the app runs with the bootstrap-admin profile.
# Password: at least 12 characters.
STAMPEDE_ADMIN_EMAIL=admin@stampede.local
STAMPEDE_ADMIN_PASSWORD=

# Optional: the backend container in docker-compose (M0.10). Defaults shown.
# Host port for the API (the container always listens on 8080 inside Docker).
# BACKEND_PORT=8080
# Spring profiles for the backend container, comma-separated. Empty = no seeding.
# STAMPEDE_COMPOSE_PROFILES=seed,demo-reschedule
# To hold demo seats now (dev only; holds before the drop return SALE_NOT_OPEN):
# STAMPEDE_COMPOSE_PROFILES=seed,demo-open-sale
