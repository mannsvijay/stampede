POSTGRES_DB=stampede
POSTGRES_USER=stampede
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Auth (M0.5). Signing key for access tokens: base64 of at least 32 random bytes.
# Generate with: openssl rand -base64 32
STAMPEDE_JWT_SECRET=change-me-run-openssl-rand-base64-32
# Tickets (M1.6, D-018). Ed25519 private key that signs tickets: base64 of exactly 32 random bytes.
# The app refuses to start until this is a valid key. Keep it secret; scanners only need the public
# key (GET /tickets/keys). Changing it gives new tickets a new key id; old tickets then fail to verify
# until key rotation is built. Generate in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or in Git Bash: openssl rand -base64 32
STAMPEDE_TICKET_SIGNING_KEY=change-me-generate-32-random-bytes-base64
# First ADMIN user, created only when the app runs with the bootstrap-admin profile.
# Password: at least 12 characters.
STAMPEDE_ADMIN_EMAIL=admin@stampede.local
STAMPEDE_ADMIN_PASSWORD=

# Optional: the backend container in docker-compose (M0.10). Defaults shown.
# Host port for the API (the container always listens on 8080 inside Docker).
# BACKEND_PORT=8080
# Spring profiles for the backend container, comma-separated. Empty = no seeding.
# STAMPEDE_COMPOSE_PROFILES=seed,demo-reschedule
# To hold demo seats now (dev only; holds before the drop return SALE_NOT_OPEN):
# STAMPEDE_COMPOSE_PROFILES=seed,demo-open-sale
